{
  "name": "wiki-infoboxes",
  "version": "2.0.0",
  "description": "Extract wikipedia article infoboxes in a structured JSON format.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "wikipedia",
    "infobox",
    "json",
    "extract"
  ],
  "author": "Juan Convers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdacjs/wiki-infoboxes.git"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.3"
  }
}
